# ============================================================
# GenRep Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---- OpenManus Engine ----
# OPENMANUS_PATH=/path/to/openmanus

# ---- Redis (Celery broker + backend) ----
REDIS_URL=redis://localhost:6379/0

# Allow Celery to fall back to filesystem transport if Redis is unavailable
ALLOW_BROKER_FALLBACK=true

# ---- Temporary File Storage ----
# REPORT_TEMP_DIR=/path/to/temp

# Skip the pre-flight GenRep readiness check (set to true for testing)
SKIP_OPENMANUS_CHECK=false

# ---- Supabase (Auth + Database) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---- Gumroad (Payments) ----
GUMROAD_PRODUCT_ID=your-product-id
GUMROAD_WEBHOOK_SECRET=your-webhook-secret
GUMROAD_CHECKOUT_URL=https://your-seller.gumroad.com/l/your-product

# ---- Rate Limiting ----
RATE_LIMIT_GENERATE=5/minute
RATE_LIMIT_ANONYMOUS_GENERATE=1/hour

# ---- Cookie Signing (for anonymous user tracking) ----
COOKIE_SECRET=generate-a-random-32-byte-hex-string

# ---- CORS (comma-separated origins) ----
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000
